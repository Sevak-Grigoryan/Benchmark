# Large binary assets go through Git LFS (GitHub rejects files over 100 MB; the Poly Haven jacaranda tree is 266 MB).
# Run `git lfs install` once before the first `git add`.
*.usdc  filter=lfs diff=lfs merge=lfs -text
*.usd   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
environments/common/px4_env/PX4-Autopilot/build/px4_sitl_default/bin/px4 filter=lfs diff=lfs merge=lfs -text
